APP_ENV=production
SECRET_KEY=
COOKIE_SECURE=true
BEHIND_PROXY=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sarvathaa_app
DB_PASSWORD=
DB_NAME=sarvathaa_courses

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SETUP_TOKEN=

PUBLIC_LOGIN_URL=https://sarvathaa.com/course-login.html
CORS_ORIGINS=https://sarvathaa.com,https://www.sarvathaa.com

# Optional email delivery. WhatsApp does not require SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Sarvathaa Team"
SMTP_USE_TLS=true
